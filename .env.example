DB_USER=trading
DB_PASSWORD=change-me
DB_NAME=trading_data
# Required by the enabled production configuration; replace all placeholders.
# Blank required credentials are rejected during startup configuration loading.
FRED_API_KEY=replace-with-your-fred-key
EIA_API_KEY=
# OpenRouter powers every analytical processor through one pinned model slug
# (llm.models.default in config/config.yaml; change it via Settings or the
# operator profile, never through a floating env alias).
OPENROUTER_API_KEY=replace-with-your-provider-key
OANDA_API_KEY=
# Optional; an explicit empty value leaves Kobeissi collection unconfigured.
TWITTERAPI_KEY=
# Regulatory filing intake.
SEC_USER_AGENT=TradingDataInvestmentResearch/1.0 contact@example.com
COMPANIES_HOUSE_API_KEY=
EDINET_API_KEY=
OPENDART_API_KEY=
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-value
TRUSTED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=0

# Maximum age of the quality snapshot embedded in orchestrator health.
HEALTH_QUALITY_CACHE_SECONDS=30
