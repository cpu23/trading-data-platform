DB_USER=trading
DB_PASSWORD=change-me
DB_NAME=trading_data
# OpenRouter is globally required. FRED and OANDA are required only when the
# corresponding collector is selected in setup/operator configuration.
FRED_API_KEY=
EIA_API_KEY=
# OpenRouter powers every analytical processor through one pinned model slug
# (llm.models.default in config/config.yaml; change it via Settings or the
# operator profile, never through a floating env alias).
OPENROUTER_API_KEY=replace-with-your-provider-key
OANDA_API_KEY=
# Optional; an explicit empty value leaves Kobeissi collection unconfigured.
TWITTERAPI_KEY=
# Regulatory filing intake.
SEC_USER_AGENT=TradingDataInvestmentResearch/1.0 contact@example.com
COMPANIES_HOUSE_API_KEY=
EDINET_API_KEY=
OPENDART_API_KEY=
# Remote production browser origins must use HTTPS. Plain HTTP is accepted only
# for an explicit loopback origin such as this single-host default.
DEPLOYMENT_MODE=production
EXTERNAL_ORIGIN=http://127.0.0.1:8000
TRUSTED_HOSTS=localhost,127.0.0.1

# Replace every value below with an independently generated secret
# (at least 32 random bytes; token_urlsafe(48) satisfies the 256-bit floor):
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SETUP_TOKEN=replace-with-a-distinct-bootstrap-token
SESSION_SIGNING_KEY=replace-with-a-distinct-session-signing-key
# Set only during a rotation grace period; remove after existing sessions expire.
SESSION_SIGNING_KEY_PREVIOUS=
CSRF_SIGNING_KEY=replace-with-a-distinct-csrf-signing-key
COOKIE_SECURE=0
# The web process calls orchestrator functions in-process; no internal URL or
# service credential is required.

# Maximum age of the quality snapshot embedded in orchestrator health.
HEALTH_QUALITY_CACHE_SECONDS=30
