DB_USER=trading
DB_PASSWORD=change-me
DB_NAME=trading_data
# Required by the enabled production configuration; replace all placeholders.
# Blank required credentials are rejected during startup configuration loading.
FRED_API_KEY=replace-with-your-fred-key
EIA_API_KEY=
# Any OpenAI-compatible endpoint. Leave LLM_API_KEY blank for local endpoints
# that do not require authentication.
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=replace-with-your-provider-key
LLM_MODEL=deepseek/deepseek-v4-flash
# Optional per-processor overrides; blank values use LLM_MODEL.
LLM_MODEL_MACRO_REGIME=
LLM_MODEL_EVENT_IMPACT=
LLM_MODEL_BRIEFING=
OANDA_API_KEY=
# Optional; an explicit empty value leaves Kobeissi collection unconfigured.
TWITTERAPI_KEY=
# Regulatory filing intake.
SEC_USER_AGENT=TradingDataInvestmentResearch/1.0 contact@example.com
COMPANIES_HOUSE_API_KEY=
EDINET_API_KEY=
OPENDART_API_KEY=
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-value
TRUSTED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=0

# Maximum age of the quality snapshot embedded in orchestrator health.
HEALTH_QUALITY_CACHE_SECONDS=30