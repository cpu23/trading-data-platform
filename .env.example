DB_USER=trading
DB_PASSWORD=change-me
DB_NAME=trading_data
# Required by the enabled production configuration; replace all placeholders.
# Blank required credentials are rejected during startup configuration loading.
FRED_API_KEY=replace-with-your-fred-key
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OANDA_API_KEY=
# Optional; an explicit empty value leaves Kobeissi collection unconfigured.
TWITTERAPI_KEY=
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
